model List {
  id            String   @id
  name          String
  description   String?
  subject       String
  userId        String
  user          User     @relation("ListOwnership", fields: [userId], references: [id], onDelete: Cascade)
  items         Json
  versionData   Json     @default("{}")
  collaborators User[]   @relation("ListCollaborators")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

enum quizQuestionType {
  select
  input
  text
  multiple_choice
  mind
}

model Quiz {
  id            String   @id
  title         String
  description   String?
  subject       String
  userId        String
  user          User     @relation("QuizOwnership", fields: [userId], references: [id], onDelete: Cascade)
  questions     Json
  versionData   Json     @default("{}")
  collaborators User[]   @relation("QuizCollaborators")
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([userId])
}

enum VoteDirection {
  up
  down
}

model ForumPost {
  id       String  @id
  content  String
  category String
  subject  String // only if category == "school-related"
  votes    Int     @default(0)
  userId   String
  user     User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  voters   Json
  deleted  Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
}
